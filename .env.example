# Public values only. Never place service-role or store secret keys in EXPO_PUBLIC variables.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=arrive_plus
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
# Optional Google Places (New) key for place search. Restrict it to the iOS/Android app in Google Cloud.
# Without it, search uses the phone's built-in geocoder.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_TERMS_URL=
# Optional generic HTTPS install page; no phone numbers, queries, or fragments.
EXPO_PUBLIC_INSTALL_URL=
# Optional Worker endpoint. When absent, Smart Reminders stay unavailable and all existing local features work.
EXPO_PUBLIC_SMART_REMINDERS_URL=
