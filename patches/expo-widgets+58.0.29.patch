+import ActivityKit
 import AppIntents
 import WidgetKit
 
@@ -119,6 +120,12 @@ struct LiveActivityUserInteraction: LiveActivityIntent {
   }
 
   func perform() async throws -> some IntentResult {
+    // Arrive patch: a target of "end" ends the activity. iOS runs a LiveActivityIntent in the
+    // app's process without opening the app, so this works even when JS isn't running.
+    if #available(iOS 16.2, *), let source, target == "end" {
+      await endLiveActivities(source: source)
+    }
+
     WidgetsEvents.shared.sendNotification(type: .userEvent, data: [
       "source": source as Any,
       "target": target as Any,
@@ -128,3 +135,13 @@ struct LiveActivityUserInteraction: LiveActivityIntent {
     return .result()
   }
 }
+
+@available(iOS 16.2, *)
+private func endLiveActivities(source: String) async {
+  // Live Activity buttons report the activity's id as their source (see LiveActivityBanner),
+  // so match on either the id or the layout name.
+  for activity in Activity<LiveActivityAttributes>.activities
+  where activity.id == source || activity.content.state.name == source {
+    await activity.end(nil, dismissalPolicy: .immediate)
+  }
+}
